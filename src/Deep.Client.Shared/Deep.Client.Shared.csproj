<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDeepTestInternals)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEP_TEST_INTERNALS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol\Deep.Protocol.csproj" />
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol.MembershipRoutes\Deep.Protocol.MembershipRoutes.csproj" />
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol.ProfileCarrier\Deep.Protocol.ProfileCarrier.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepProtocolLocalCutover)' == 'true'">
    <InternalsVisibleTo Include="Deep.Protocol.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clean break: the Session-derived runtime and its MSG-01 bridge are not
         part of the current client assembly. Current code binds the store to an
         exact Deep account/device MessageStoreScope. -->
    <Compile Remove="Persistence\MessagingV1\Msg01AuthoritativeTransport.cs" />
    <Compile Remove="Services\MessageNetworkRuntime.cs" />
    <Compile Remove="Services\MessageService.cs" />
    <Compile Remove="Services\InboxSyncService.cs" />
    <Compile Remove="Services\PushSubscriptionTransport.cs" />
    <Compile Remove="State\ClientRuntime.cs" />
    <Compile Remove="Persistence\SqliteDeepMailboxStore.cs" />
    <Compile Remove="obj-production\**\*.cs" />
    <Compile Remove="bin-production\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference corpus only until its remaining consumers are recomposed. -->
    <EmbeddedResource Include="Resources\Mnemonic\english.txt"
                      LogicalName="Deep.Client.Shared.Resources.Mnemonic.english.txt" />
  </ItemGroup>

</Project>
