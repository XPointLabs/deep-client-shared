    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DEEP_CLEAN_PRODUCTION</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Deep.Client.Shared</AssemblyName>
    <RootNamespace>Deep.Client.Shared</RootNamespace>
    <BaseOutputPath>bin-production\</BaseOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
