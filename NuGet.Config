<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="p04-local-pinned"
         value="vendor\p14a2\packages" />
    <add key="p15-membership-routes-local-pinned"
         value="vendor\p15\packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="p04-local-pinned">
      <package pattern="Deep.Protocol" />
      <package pattern="Deep.Protocol.ProfileCarrier" />
      <package pattern="Sodium.Core" />
      <package pattern="libsodium" />
      <package pattern="Microsoft.*" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="System.*" />
      <package pattern="coverlet.collector" />
      <package pattern="xunit*" />
    </packageSource>
    <packageSource key="p15-membership-routes-local-pinned">
      <package pattern="Deep.Protocol.MembershipRoutes" />
    </packageSource>
  </packageSourceMapping>
</configuration>
